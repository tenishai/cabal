# identity.toml — Cabal Core configuration
#
# Copy to identity.toml and adjust. Loaded by `cbl daemon up`.

[cabal]
host = "127.0.0.1"
port = 7400
data_dir = "data"

# ----- LiteLLM proxy -----
# api_base points at a running LiteLLM proxy. api_key_env names the env
# var Cabal reads to inject the master key as Bearer.

[litellm]
api_base = "http://litellm:4000"
api_key_env = "LITELLM_MASTER_KEY"

# ----- Observability (optional) -----
# When host + public/secret env vars are all set, the TraceExporter
# registers async handlers for SESSION_START/END + LITELLM_POST and
# forwards generations to Langfuse. Comment out to disable.

[langfuse]
host = "https://cloud.langfuse.com"
public_key_env = "LANGFUSE_PUBLIC_KEY"
secret_key_env = "LANGFUSE_SECRET_KEY"

# ----- Singletons (built-in personas) -----
# Each persona declared here gets a bulletin-board row at daemon startup.
# Personas named in PERSONA_REGISTRY (archivist, architect, librarian)
# also get a LocalHandler so dispatches actually reach an LLM. Personas
# NOT in the registry register a bulletin row but error on dispatch.

[personas.archivist]
description = "Memory and search"
role = "singleton"
safety_tier = "moderate"

[personas.architect]
description = "Patterns and design"
role = "singleton"
safety_tier = "moderate"

[personas.librarian]
description = "External-documentation lookup"
role = "singleton"
safety_tier = "moderate"

# ----- Primus (Phase 2 — declares but no handler yet) -----
# Rook is the engineering primus. Its bulletin row registers as
# 'rook-primus' / generation=1, but no LocalHandler exists yet — Phase 2
# will land a primus handler that dispatches to subordinates.

[personas.rook]
description = "Engineering primus"
role = "primus"
safety_tier = "strict"

[personas.rook.subordinates.implementer]
model = "anthropic/claude-sonnet-4-6"
max_tokens = 16384

[personas.rook.subordinates.reviewer]
model = "anthropic/claude-opus-4-7"
max_tokens = 8192
