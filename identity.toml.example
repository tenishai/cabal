# identity.toml — Cabal Core configuration
#
# Copy to identity.toml and adjust. Loaded by `cbl daemon up`.

[cabal]
host = "127.0.0.1"
port = 7400
# $CABAL_DATA_DIR overrides data_dir; the image sets it to /data.
data_dir = "data"
# The URL clients reach this cabal at. A2A v1.0 agent cards name each persona's
# interface by it and are not served without it. $CABAL_PUBLIC_URL overrides it.
# public_url = "https://cabal.example"
# The persona whose A2A v1.0 card is served at /.well-known/agent-card.json, the
# host's front door. Unset, that URL answers 404. $CABAL_FRONT_DOOR overrides it.
# front_door = "mason-primus"
# How many messages of a conversation an A2A v1.0 SendMessage replays to the
# persona when it starts a new task in an existing contextId (newest kept). 0 is off.
# context_replay_messages = 40
# A2A v1.0 SendMessage with returnImmediately runs detached: at most this many at once
# (more are refused), and each gets this many seconds to stop on shutdown.
# detached_task_limit = 16
# detached_drain_seconds = 10
# Where the operator bootstrap code minted at each start goes: "log" (the daemon
# log, which `make bootstrap` and the k8s steps read), "file" ($CABAL_HOME/bootstrap_code,
# owner-only, with only its path logged) or "off" (no code). Logs get copied and
# shipped, so use "file" or "off" once you have an operator. $CABAL_BOOTSTRAP_CODE
# overrides it.
# bootstrap_code = "log"

# ----- LiteLLM proxy -----
# api_base points at a running LiteLLM proxy. api_key_env names the env
# var Cabal reads to inject the master key as Bearer.
# Name models as the proxy serves them under an `anthropic/` or `openai/`
# prefix. A Gemini or Vertex name (`gemini-...`, `gemini/`, `vertex_ai/`)
# makes the litellm SDK call Google itself and skip api_base, and the image has
# no `google` package, so Gemini or Vertex needs extra setup (issues 257, 335).

[litellm]
api_base = "http://litellm:4000"
api_key_env = "LITELLM_MASTER_KEY"

# ----- Memory (techne) -----
# When db_path is set, the Archivist persona gets a techne-backed
# MemoryStore. Recall happens on every dispatch — relevant facts get
# injected into the system prompt. Comment out to disable.

[techne]
db_path = "data/techne.db"
use_vectors = false

# ----- Observability (optional) -----
# When host + public/secret env vars are all set, the TraceExporter
# registers async handlers for SESSION_START/END + LITELLM_POST and
# forwards generations to Langfuse. Comment out to disable.

[langfuse]
host = "https://cloud.langfuse.com"
public_key_env = "LANGFUSE_PUBLIC_KEY"
secret_key_env = "LANGFUSE_SECRET_KEY"

# ----- MCP gateway (liminal, optional) -----
# When url is set AND a persona has [personas.NAME.mcp].enabled=true,
# that persona's handler arrives with an MCPToolProxy wired to liminal.
# Cabal mints a per-request JWT signed with its active signing key;
# liminal verifies against /.well-known/jwks.json on cabal-core.

[liminal]
url = "http://liminal:9100"
token_ttl_seconds = 3600
jwt_aud = "liminal"

# ----- Router-level guardrails -----
# These run in DispatchRouter.dispatch BEFORE the local-vs-remote branch, so
# they are the one enforcement point that also covers federated peers. The
# in-process Mason doom-loop guard fires at the subordinate boundary only and
# never reaches a remote hop.
#
# NOTE a primus fan-out bypasses the router (_dispatch_subordinate calls
# handle_task directly), so doom_loop, delegation_budget and delegation_depth
# also run at the subordinate boundary there (cabal#158, #171).

[guardrails]
# doom_loop = true             # sameness counter; threshold below
# doom_loop_threshold = 5
# delegation_budget = true     # payload-independent per-conversation cap
# doom_loop_ttl_s = 600.0       # widened to 2x CABAL_DISPATCH_TIMEOUT_S if that is larger
# delegation_depth = true       # refuse a chain deeper than the limit, arriving or fanned out (cabal#144, #171)
# delegation_depth_limit = 8
# delegation_budget_limit = 40
# delegation_budget_caller_window_seconds = 3600.0
# delegation_budget_retention_s = 86400.0   # how long a persisted conversation count is honoured

# cabal#154 -- refuse a delegation with no declared edge. OFF by default, and
# that is a migration decision rather than a judgement about the control: the
# guard's OWN default is deny, so enabling this in a room with no
# `may_delegate_to` lines turns ALL delegation off at once. Declare the edges
# first (see [personas.archivist] below), then switch this on.
# delegation_edges = false

# cabal#189 -- edges for callers that are not personas here: room colleagues
# and outside agents, whose tokens carry sub = "agent:<name>" and no persona.
# Keyed by that FULL sub, prefix included; targets are persona names, as in
# may_delegate_to. A sub with no line here may delegate to nobody once
# delegation_edges is on. The room's dispatch pairs are a separate check and
# do not count as edges.
# [guardrails.caller_edges]
# "agent:ext-acme" = ["archivist"]

# ----- Singletons (built-in personas) -----
# Each persona declared here gets a bulletin-board row at daemon startup.
# Personas named in PERSONA_REGISTRY (archivist, architect, librarian,
# mason, wright)
# also get a LocalHandler so dispatches actually reach an LLM. Personas
# NOT in the registry register a bulletin row but error on dispatch.

[personas.archivist]
description = "Memory and search"
role = "singleton"
safety_tier = "moderate"

# ----- Delegation edges (cabal#154) -----
# Which PERSONAS this one may delegate to. The colleague list is a phone book
# -- anything visible is askable; this makes it an adjacency list.
#
# READ THE DEFAULT CAREFULLY. It is the OPPOSITE of `allowed_handlers` below:
#   allowed_handlers omitted  ->  UNRESTRICTED (every handler is reachable)
#   may_delegate_to  omitted  ->  NO DELEGATION (nobody is reachable)
# That is deliberate and it is the point. "A room with no declared
# relationships permits no delegation" is what makes this an authorization
# control rather than a suggestion; a permissive default would give any agent
# that can name a colleague the right to storm it.
#
# INERT UNLESS [guardrails] delegation_edges = true, which is currently false
# by default -- every existing room has no edges declared, so switching it on
# would turn all delegation off at once. Declare edges first, then enable.
#
# Edges are OPERATOR-AUTHORED and never agent-supplied: they are read from this
# file at startup and nothing on the dispatch path can add one.
#
# Names are personas. A role = "primus" persona is reached under the agent name
# "<persona>-primus"; cabal resolves that, so write the persona name.
#
# may_delegate_to = ["librarian", "architect"]

# Archivist opts into liminal's tool surface (memory lookups, web fetch,
# files, etc. — whatever liminal's registry serves). With [liminal]
# configured above AND this enabled flag, the archivist handler is wired
# with a MCPToolProxy at startup; subsequent LLM calls get tools=... and
# the persona can issue tool_calls that route through liminal.
[personas.archivist.mcp]
enabled = true
# max_steps = 4  # uncomment to override LLMPersona's default tool-use cap
# Which liminal handlers this persona can see + call. Omit (or set to
# null) for "unrestricted" (every handler liminal serves is reachable).
# An empty list `[]` is meaningful too: revokes all tool access without
# disabling mcp.enabled. Folds into cabal_tool_extras["liminal.allowed_handlers"]
# at JWT-mint time; liminal filters tools/list AND refuses tools/call
# accordingly.
allowed_handlers = ["memory", "notify"]

# Per-persona scoping config forwarded to liminal as Context.extra. The
# key names are the handler-author's contract (web reads
# `web.allowed_hosts`, files reads `files.allowed_paths`, memory reads
# `memory.db_path`). Anything in this table flows verbatim into the JWT
# `cabal_tool_extras` claim liminal extracts.
[personas.archivist.mcp.tool_extras]
"web.allowed_hosts" = ["docs.python.org", "*.example.com"]
# "files.allowed_paths" = ["~/notes/archivist"]
# "memory.db_path" = "data/archivist-memory.db"

[personas.architect]
description = "Patterns and design"
role = "singleton"
safety_tier = "moderate"
# Operator overrides — flip any persona's prompt, model, max_tokens, or
# memory-accumulation default without editing Python. Uncomment to use.
# system_prompt_override = "You are my Architect. Recommend battle-tested patterns and call out the cost of every recommendation."
# model_override = "anthropic/claude-opus-4-7"
# max_tokens_override = 16384
#
# commit_to_memory — WRITE the persona's own Q&A back into its memory store.
# OFF for every persona, including the Archivist (cabal#139). It was on for the
# Archivist, which is the persona least able to afford it: every other persona
# writing to memory pollutes a store someone ELSE reads, while the Archivist
# pollutes the store IT searches, so its own answer is recallable on the next
# dispatch. Reported in cabal#141: a recall returned two hits, both the
# agent's prior answers, both carrying the same fabricated citation, from a
# store of 1,118 curated rows.
#
# Turning it on is a legitimate choice for a persona whose exchanges you want
# accumulated. Know what you are getting: rows land as type="fact" at medium
# confidence -- the same standing as anything you curated by hand, and nothing
# STRUCTURAL at recall time tells the two apart. (The `[archivist]` content
# prefix and the `archivist` tag DO reach the prompt, on purpose, so search
# results stay attributable -- but they are advisory text the model may ignore.
# MemoryHit carries no source field, so nothing filters, ranks or gates on any
# of it.) cabal#141 is the fix for that half.
#
# NOTE THE SECTION. This explanation sits under [personas.architect] because
# that is where the generic override block lives -- so the line below would
# enable accumulation on the ARCHITECT. To turn the ARCHIVIST's back on, put
# `commit_to_memory = true` under [personas.archivist] above.
# commit_to_memory = true
# extra_kwargs — provider/model knobs Cabal has no field of its own for, passed
# straight through to the LLM call.
# extra_kwargs = { chat_template_kwargs = { enable_thinking = false } }
#
# THAT LINE IS THE ONE THAT MATTERS FOR A LOCAL REASONING MODEL, and the
# failure it prevents does not look like a failure. With thinking ON, a Qwen-
# class model returns its own chain of thought AS THE ANSWER and stops
# mid-deliberation — not an error, not empty, just wrong. Measured against a
# local OpenAI-compatible endpoint, same persona, same prompt:
#
#   thinking on    5142 tok   80s   18220 chars of the model deciding whether
#                                   it is allowed to multiply 17x23
#   thinking on    2248 tok   34s   a real but slow answer
#   ---- enable_thinking = false from here ----
#   thinking off     45 tok    3s   a real answer
#   thinking off     24 tok    2s   a real answer
#
# Check your model's own flag name; this one is honoured only as
# chat_template_kwargs.enable_thinking.
#
# A SECOND IDENTITY NEEDS CABAL_DB_URL, and this catches people out:
# `cabal.data_dir` below does NOT set the sqlite path. The engine reads
# CABAL_DB_URL or falls back to one default per root (./data/cabal.db when the
# working directory holds cabal state, else $CABAL_HOME/data/cabal.db), so a
# second identity run from the same root without it writes into the FIRST one's
# database.
#
#   export CABAL_DB_URL=sqlite+aiosqlite:///data-second/cabal.db
#
# Keys Cabal binds itself are REFUSED at startup, naming the key: model,
# messages, agent, trace_id, span_id, task_id, max_tokens, api_base, api_key,
# tools, stream. Use max_tokens_override and the [litellm] block for those.
#
# A PRIMUS passes its extra_kwargs down to its subordinates, so one line covers
# plan, implementer and aggregate. A subordinate that sets its own replaces the
# inherited value; to send NOTHING on that hop, set it to empty explicitly:
#     [personas.wright.subordinates.implementer]
#     model = "openai/some-local-model"
#     extra_kwargs = {}          # omit the line entirely to inherit instead
# edit_format: "none" (default) or "search-replace". When set to
# "search-replace", Cabal Core auto-appends aider-style SEARCH/REPLACE
# block instructions to this persona's system prompt, AND `cbl chat`
# parses + applies the resulting blocks (with operator y/n) when
# launched with `--edit-format search-replace`. Recommended for any
# persona that emits code edits (architect, codex, mason).
# edit_format = "search-replace"
# cabal#2 — opt into checkpoint-based durable execution. When enabled,
# every LLM call inside handle_task writes a row to task_checkpoints;
# if the daemon dies mid-loop, the operator can resume via
# POST /admin/tasks/{id}/resume. Default off — heavy step writes
# aren't free; flip on for personas with long tool-use chains.
# [personas.architect.checkpointing]
# enabled = true

[personas.librarian]
description = "External-documentation lookup"
role = "singleton"
safety_tier = "moderate"

# ----- Primus -----
# Mason is the SRE / reliability primus — infrastructure, platform, deployment
# and operational correctness. (Wright, below, is the software one.) Its bulletin
# row registers as 'mason-primus' / generation=1 and the LocalHandler is wired
# automatically.
# Pipeline per dispatch: PLAN (primus) → IMPLEMENT (implementer subordinate)
# → REVIEW (reviewer subordinate, if declared) → AGGREGATE (primus).
# Comment out [personas.mason.subordinates.reviewer] to skip the review step.

[personas.mason]
description = "Engineering / SRE primus"
role = "primus"
safety_tier = "strict"
# max_legs_override = 1
#
# A DECLARATION CAP, NOT A THROTTLE (cabal#172). It caps how many fan-out legs
# this primus may DECLARE -- checked once, when the handler is built. It does
# not trim a wide fan-out down to size.
#
# THE REVIEWER IS NOT A LEG, AND THAT IS THE TRAP HERE. Legs are the
# subordinates dispatched CONCURRENTLY on the plan; the reviewer runs after
# them, so it is excluded from the count. Mason declares implementer AND
# reviewer below and that is ONE leg, not two -- so `max_legs_override = 1`
# admits mason exactly as shipped. Count your non-reviewer subordinates, not
# your subordinates.
#
# SETTING IT BELOW THAT COUNT REMOVES THE PERSONA RATHER THAN NARROWING IT.
# Add a second non-reviewer subordinate here and `max_legs_override = 1` stops
# mason booting altogether: the handler is skipped with a
# `personas.primus_config_rejected` error and the rest of the roster still
# starts. Read it as "this persona must not declare more than N legs".
#
# Lowers only. A value above the module ceiling (8) is clamped to it and
# logged. A value below 1 is refused outright when the config loads.
#
# leg_token_budget_override = 100000
# fanout_token_budget_override = 300000
#
# TOKEN SPEND FOR THE FAN-OUT (issue 394). Each worker -- every leg AND the
# reviewer, since both make model calls -- gets `leg_token_budget_override`
# tokens, carved out of the fan-out's budget when it starts and returned
# unused when it ends. `fanout_token_budget_override` is the ceiling for
# the whole fan-out: the primus's plan and aggregate calls plus every
# worker. If it can't cover every worker and one aggregate call, the
# fan-out is refused before any worker starts. Unset: 200000 per worker,
# and a fan-out of 200000 plus one allotment per worker. A worker's
# allotment must be at least 50000, the amount each model call reserves
# before it runs; a smaller one is refused when the config loads.

[personas.mason.subordinates.implementer]
model = "anthropic/claude-sonnet-4-6"
max_tokens = 16384

[personas.mason.subordinates.reviewer]
model = "anthropic/claude-opus-4-7"
max_tokens = 8192

# ----- Wright primus -----
# Wright is the general-engineering primus. Its bulletin row registers as
# 'wright-primus' / generation=1 and the LocalHandler is wired automatically.
# Pipeline per dispatch: PLAN (primus) → IMPLEMENT (implementer subordinate)
# → REVIEW (reviewer subordinate, if declared) → AGGREGATE (primus).
# Wright ships WITHOUT a reviewer: uncomment [personas.wright.subordinates.reviewer]
# below to add the REVIEW step. (Mason ships with one.)

[personas.wright]
description = "Senior software engineer — general-engineering primus"
role = "primus"
safety_tier = "strict"
# max_legs_override = 1   # see the note under [personas.mason]. Wright ships
#                         # one subordinate and no reviewer -- one leg either
#                         # way -- so 1 admits it and 0 is refused at load.

[personas.wright.subordinates.implementer]
model = "anthropic/claude-sonnet-5"
max_tokens = 16384

# [personas.wright.subordinates.reviewer]
# model = "anthropic/claude-sonnet-5"
# max_tokens = 8192

# Groups (cabal issue 423): `cbl dispatch --detach group:<name> "<brief>"` queues a
# task that starts on the first member with nothing running, in the order listed.
# It waits as `scheduled` while every member is busy; `cbl tasks --scheduled` shows it.
# [groups]
# wright = ["wright-secundus", "wright-tertius", "wright-quartus"]

# The token meter (cabal issue 394, part 2). Off unless enabled. A metered agent's
# model base URL is <cabal>/meter/<key> (ergon sets ANTHROPIC_BASE_URL or
# ERGON_MODEL_API_BASE when the set file says `[cabal] meter = true`, and writes
# this section). Each call is forwarded to `upstream` unchanged: the caller's own
# Authorization goes through, and cabal never stores or swaps a credential. The
# usage on the response is charged to the task the agent is running. Only input +
# output tokens count against a budget; cache tokens are recorded, not charged.
# Rows are in the `meter_spend` table. An agent running two tasks at once can't
# have a call pinned to either; such calls are counted as `ambiguous`.
# [meter]
# enabled = true
# task_budget = 2000000   # per task; unset = measure only. Over it: a 400.
# root_budget = 8000000   # all metered tasks under one root; needs task_budget
# [meter.agents.wright-secundus]
# key_sha256 = "<sha256 of the key in the agent's base URL>"
# upstream = "https://api.anthropic.com"

# The review workflow (cabal issue 399). Off unless enabled. Queue a run with
# `cbl review start <owner/repo> <pr> --sha <sha>`; the engine takes it through the
# seats in order, reading each seat's outcome itself, never its exit code.
# [review]
# enabled = true
# max_running = 3
# step_timeout_s = 5400
# seats_default = ["temperance", "prudence"]
# seat_kinds = { temperance = "prepass", prudence = "github_review" }
# review_logins = { prudence = "prudence-tenishai" }
# # Prints {"workspace": ..., "brief": ..., "metadata": {...}} as its last stdout line.
# prepare_command = ["/path/to/agents/scripts/fates-dispatch.sh", "--prepare-only", "--notes", "{notes}",
#                    "--prepass", "{prepass}", "{seat}", "{repo}", "{pr}", "{sha}"]
# cleanup_command = ["rm", "-rf", "{workspace}"]
# notify_command = ["/path/to/notify-review.sh"]   # gets the run as JSON on stdin
# github_token_env = "CABAL_GITHUB_TOKEN"          # read PRs, reviews and CI; remove labels; merge
#                                # The token's account needs write on every watched repo: with
#                                # read it can't see roles (every labeller reads as none) or remove labels.
# label = "ready-for-review"     # a PR carrying it in a watched repo is reviewed at its head
#                                # unless GitHub says it conflicts with its base: then the label comes off.
# label_min_role = "write"      # least role whose label counts (triage can label on GitHub)
# watch_poll_seconds = 300
# ci_timeout_s = 3600            # the merge gate's wait for green CI, from approval
# [review.repos."tenishai/techne-next"]
# merge = true                   # approved runs merge once CI is green, pinned to the sha (default false)
#                                # It refuses when the base branch has changed, since the merge-base,
#                                # a file the PR changes; update the branch and review again. Paths
#                                # only: a base change to a file the PR merely depends on passes.
# ci = "github"                  # every check run and commit status green; "none" skips the wait
#                                # The gate sees only checks that have reported: it can't tell a
#                                # required check that hasn't started yet (a chained workflow_run)
#                                # from one that isn't coming. Branch protection's required checks
#                                # are the backstop; set them on any repo with merge = true.
# merge_method = "squash"
# allow_forks = false           # review fork PRs; never with merge = true
# [review.repos."tenishai/cabal"]
# seats = ["prudence"]           # this repo's seats; unset: seats_default
