/identity.toml.*

# THE MASTER KEY AND THE LIMINAL SERVICE TOKEN. Tracked until 2026-09-23
# (#196) — the committed values are rotated and dead, but they are still in
# this repo's history, so treat anything that was in this file before that date
# as public. `make up` mints a fresh CABAL_MASTER_KEY when this file is absent,
# which is what the Makefile rule was always for and what tracking defeated.
.env
