# Copy to .env and fill in. Used by docker-compose.yml / docker-compose.dev.yml.
# For the dev stack: run `make up` — it auto-creates .env with a fresh CABAL_MASTER_KEY.

# REQUIRED — Cabal Core master encryption key.
# Generate once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# THERE IS NO RE-ENCRYPTION PATH (#196). Change this key and the existing
# signing_keys/secrets rows can no longer be decrypted: `cbl reset-auth` backs
# the database up and regenerates the signing key, and `--purge-secrets` drops
# stored secrets unrecoverably. A reset also invalidates LIMINAL_CABAL_TOKEN
# below, which is signed by that key and must be re-minted.
CABAL_MASTER_KEY=

# REQUIRED for liminal credential fetch — secrets-fetch JWT.
# Populated automatically by `make bootstrap` (dev stack).
# Production: run `cbl token mint-service --scope secrets-fetch --ttl-days 365`.
LIMINAL_CABAL_TOKEN=

# REQUIRED — LiteLLM proxy master key (Cabal passes this as the Bearer
# when calling the proxy). Generate any 32+ char random string.
LITELLM_MASTER_KEY=

# REQUIRED for any anthropic model — LiteLLM uses this to reach the
# upstream provider.
ANTHROPIC_API_KEY=

# OPTIONAL — add if you reference OpenAI models in compose/litellm-config.yaml.
# OPENAI_API_KEY=

# OPTIONAL — Langfuse for trace export. Comment out the [langfuse]
# block in identity.toml if you're not using these.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# OPTIONAL — federated dispatch HTTP read ceiling, in seconds. Default 30
# (the historical hardcoded value). Raise it for a slow federated peer (e.g.
# one fronting a real model call); connect stays pinned at 10s regardless, so
# an unreachable peer still fails fast. If raised above 300 (half of
# guardrails.doom_loop_ttl_s's own default of 600), the doom-loop guard's TTL
# is auto-widened to 2x this value so a hanging peer can't defeat it by
# resetting the guard's count every attempt; see _doom_loop_ttl in
# src/cabal/core/app.py.
#
# `cbl` reads this too: the two dispatch routes allow 2x this value, so the
# CLI outlasts the daemon it is waiting on. All other `cbl` calls stay at 30s.
# CABAL_DISPATCH_TIMEOUT_S=30
