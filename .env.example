# Copy to .env and fill in. Used by docker-compose.yml / docker-compose.dev.yml.
# For the dev stack: run `make up` — it auto-creates .env with a fresh CABAL_MASTER_KEY.

# REQUIRED — Cabal Core master encryption key.
# Generate once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CABAL_MASTER_KEY=

# REQUIRED for liminal credential fetch — secrets-fetch JWT.
# Populated automatically by `make bootstrap` (dev stack).
# Production: run `cbl token mint-service --scope secrets-fetch --ttl-days 365`.
LIMINAL_CABAL_TOKEN=

# REQUIRED — LiteLLM proxy master key (Cabal passes this as the Bearer
# when calling the proxy). Generate any 32+ char random string.
LITELLM_MASTER_KEY=

# REQUIRED for any anthropic model — LiteLLM uses this to reach the
# upstream provider.
ANTHROPIC_API_KEY=

# OPTIONAL — add if you reference OpenAI models in compose/litellm-config.yaml.
# OPENAI_API_KEY=

# OPTIONAL — Langfuse for trace export. Comment out the [langfuse]
# block in identity.toml if you're not using these.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
